# Security-sensitive values are required; there are no production defaults.
# Generate SECRET_KEY with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Generate QUERY_ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QUERY_ENCRYPTION_KEY=

APP_DATABASE_URL=
CENTRAL_DB_USER=
CENTRAL_DB_PASSWORD=

# Company self-registration is fail-closed when this is empty.
# Leading '@' is accepted; multiple exact domains are comma-separated.
ALLOWED_EMAIL_DOMAINS=
# New registrations remain inactive until a platform admin enables them.
REGISTRATION_REQUIRES_ACTIVATION=true
# Usernames allowed to activate accounts and manage platform-scoped users.
PLATFORM_ADMINS=
