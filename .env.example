# Copy to .env at repository root. See docs/configuration.md.
# This file is intentionally NOT runnable until required secrets are filled.
# Defaults below favor production; for local HTTP only set DEBUG=true and
# COOKIE_SECURE=false. Never publish your .env or resolved Compose config.

# Required: random signing key, at least 32 characters.
SECRET_KEY=
# Required: valid Fernet key; alternatively use the ordered rotation key list.
QUERY_ENCRYPTION_KEY=
# Newest key first. A non-empty list takes precedence over the single key.
QUERY_ENCRYPTION_KEYS=

# Required: WebQuery's metadata database (not a user-query target database).
# Native example shape (URL-encode user/password yourself):
# mssql+aioodbc://USER:ENCODED_PASSWORD@localhost:1433/dba_application_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Compose overrides this URL using DB_USER and DB_PASSWORD below.
APP_DATABASE_URL=
# Required by the bundled SQL Server Compose/bootstrap workflow.
DB_USER=webquery_app
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=dba_application_db

# Still required by the startup guard for legacy registrations without tier
# credentials. Do not use a privileged target account or metadata sa account.
CENTRAL_DB_USER=
CENTRAL_DB_PASSWORD=
# Legacy server catalogue fallback; registered targets are managed in the UI.
SQL_SERVER_NAMES=localhost

# Required Redis dependency; Compose overrides the address to its redis service.
REDIS_URL=redis://localhost:6379/0
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOGIN_THROTTLE_KEY_PREFIX=webquery:login-throttle

# Empty exact-domain allowlist disables self-registration.
ALLOWED_EMAIL_DOMAINS=
REGISTRATION_REQUIRES_ACTIVATION=true
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_HOURS=12
REFRESH_GRACE_SECONDS=30
SESSION_TIMEOUT_MINUTES=60
RATE_LIMITER=3/minute
REFRESH_RATE_LIMITER=30/minute
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Native backend behind no proxy: blank. Compose's base defaults a blank value
# to 172.16.0.0/12; verify and narrow its proxy/network scope before production.
TRUSTED_PROXY_IPS=

# Query/connection limits; target accounts are configured per tier in the UI.
QUERY_TIMEOUT_SECONDS=300
MAX_ROW_COUNT_LIMIT=1000
MAX_ROW_COUNT_WARNING=10000
QUERY_RATE_LIMITER=10/minute
MAX_JOINS=8
PERFORMANCE_BLOCKS=false
ENGINE_CACHE_TTL_SECONDS=1800

# Optional Slack approval integration. Missing tokens do not stop API startup.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ADMIN_CHANNEL=
# Optional legacy webhook notification channel.
SLACK_URL=

# app.py reads ENV_FILE before domain imports; native startup from web_api/.
ENV_FILE=../.env
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
WORKERS=1
